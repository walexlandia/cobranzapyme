POSTGRES_DB=recupera
APP_VERSION=0.8.4
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
POSTGRES_USER=recupera
POSTGRES_PASSWORD=recupera_dev_only
DATABASE_URL=postgresql+psycopg://recupera:recupera_dev_only@db:5432/recupera
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
DOCUMENT_ENCRYPTION_KEY=replace-with-a-distinct-at-least-32-character-secret
REPORT_ANONYMIZATION_KEY=replace-with-an-independent-at-least-32-character-secret
MINIO_ROOT_USER=recupera
MINIO_ROOT_PASSWORD=recupera_dev_only
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=recupera-documents
NEXT_PUBLIC_API_URL=http://localhost:8000
